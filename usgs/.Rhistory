Gam.object <- gam(JAI~ s(gsi)+s(beaufort_elev)+
s(tow_temp_albermale)+s(salt.di)+s(Riv_ann)
+s(Riv.di),family=Gamma, data=usedata)
new_data<-NULL
new_data<-data.frame( gsi=J$gsi[test],  beaufort_elev=J$beaufort_elev[test],
tow_temp_albermale=J$tow_temp_albermale[test],
salt.di  =J$salt.di[test], Riv_ann=J$Riv_ann[test],
Riv.di=J$Riv.di[test]
)
pr<-predict.gam(Gam.object, new_data, type="response")
plot(J$JAI, type="b", main = "GAM JAI prediction vs observed")
lines(seq(1,42,1)[-test],Gam.object$fitted.values, type="b", col="red")
lines( test, pr, type="b", col="blue" )
}
