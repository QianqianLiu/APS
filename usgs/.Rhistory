class(ore_msl$Date)  # It should return "Date"
ore_msl$year <- year(ore_msl$Date)
ore_msl$month <- month(ore_msl$Date)
ore_msl$day <- day(ore_msl$Date)
ore_msl <- aggregate(MSL..m. ~ year, data = ore_msl, FUN = mean)
ore_msl <- ore_msl[ore_msl$year <= 2021, ]
#ore_msl <- ore_msl[ore_msl$month %in% c(5, 6), ]
# Check if years 1978 and 1979 are missing
missing_years <- c(1979:2021)
missing_years <- missing_years[!missing_years %in% unique(ore_msl$year)]
# Create new rows for missing years
missing_data <- data.frame(Date = as.Date(paste0(missing_years, "-01-01")),
MSL..m. = NA,
year = missing_years,
month = NA,
day = NA)
# Create a dataframe with same column names as ore_msl
missing_data <- missing_data[, names(ore_msl)]
# Bind missing data to ore_msl dataframe
ore_msl <- rbind(ore_msl, missing_data)
ore_msl <- ore_msl[order(ore_msl$year), ]
# convert Hatteras station stuff
hat_msl <- hat_sta[, c("Date", "MSL..m.")]
class(hat_msl$Date)  # It should return "Date"
hat_msl$year <- year(hat_msl$Date)
hat_msl$month <- month(hat_msl$Date)
hat_msl$day <- day(hat_msl$Date)
hat_msl <- aggregate(MSL..m. ~ year, data = hat_msl, FUN = mean)
hat_msl <- hat_msl[hat_msl$year <= 2021, ]
#hat_msl <- hat_msl[hat_msl$month %in% c(5, 6), ]
missing_years <- c(1979:2021)
missing_years <- missing_years[!missing_years %in% unique(hat_msl$year)]
missing_data <- data.frame(Date = as.Date(paste0(missing_years, "-01-01")),
MSL..m. = NA,
year = missing_years,
month = NA,
day = NA)
missing_data <- missing_data[, names(hat_msl)]
hat_msl <- rbind(hat_msl, missing_data)
hat_msl <- hat_msl[order(hat_msl$year), ]
# next add these to J
oregon_elev <- ore_msl[, !names(ore_msl) %in% c("year")]
hatteras_elev <- hat_msl[, !names(hat_msl) %in% c("year")]
combined_msl <- cbind(hatteras_elev, oregon_elev)
J_msl <- cbind(J, combined_msl)
write.csv(J_msl, file = "/Users/kboothomefolder/DSC_Proj/00_in_progress/J_msl.csv", row.names = FALSE)
